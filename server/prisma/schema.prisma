generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  phone     String
  course    String?
  message   String?
  status    String   @default("new")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_submissions")
}
